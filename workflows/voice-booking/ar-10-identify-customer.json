{
  "name": "AR-10 Identify customer by VIN and MSISDN",
  "nodes": [
    {
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "vin",
              "type": "string"
            },
            {
              "name": "msisdn",
              "type": "string"
            },
            {
              "name": "correlationId",
              "type": "string"
            }
          ]
        }
      },
      "id": "f35f65f7-ce09-5a7d-85f2-c6e0d2525206",
      "name": "ToolInput",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/ar-mock/crm/customer-lookup",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ vin: $json.vin, msisdn: $json.msisdn, correlationId: $json.correlationId }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "414110aa-40f6-5be2-aa0d-b1fcfc30b0cc",
      "name": "CallCrm",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        208,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ca1145ad-b6d7-5bb4-8a84-5d7610593508",
              "name": "ok",
              "value": true,
              "type": "boolean"
            },
            {
              "id": "5ba1f884-3617-5c9e-acfd-6412eea5b552",
              "name": "known",
              "value": "={{ !!$json.found }}",
              "type": "boolean"
            },
            {
              "id": "26951ea4-b2db-5c15-9916-f90dd56a3868",
              "name": "customerRef",
              "value": "={{ $json.customerRef || '' }}",
              "type": "string"
            },
            {
              "id": "d06059e1-3a2e-5399-8e83-c6dc7221ab74",
              "name": "accountName",
              "value": "={{ $json.accountName || '' }}",
              "type": "string"
            },
            {
              "id": "42e01b15-da34-52cc-a5ae-2591167cdb61",
              "name": "vehicleRef",
              "value": "={{ $json.vin || '' }}",
              "type": "string"
            },
            {
              "id": "d3e6647f-f9e2-5afc-826c-9ff75722587c",
              "name": "greetingName",
              "value": "={{ $json.greetingName || '' }}",
              "type": "string"
            },
            {
              "id": "242f81d9-8842-5b4d-9c58-f0ad8877cfac",
              "name": "vehicleLabel",
              "value": "={{ $json.vehicleLabel || '' }}",
              "type": "string"
            },
            {
              "id": "c4e19414-2354-5cc7-a6d4-452b1f6c2809",
              "name": "preferredDealerId",
              "value": "={{ $json.preferredDealerId || '' }}",
              "type": "string"
            },
            {
              "id": "4a1a9171-28dd-5b8a-9a8c-266a7d8f90b5",
              "name": "preferredDealerName",
              "value": "={{ $json.preferredDealerName || '' }}",
              "type": "string"
            },
            {
              "id": "17c09cb6-0f7b-5f12-b5d7-a840f4fb752b",
              "name": "market",
              "value": "={{ $json.market || '' }}",
              "type": "string"
            },
            {
              "id": "98769343-f0eb-5c96-a0bd-10f1d44596c9",
              "name": "language",
              "value": "={{ $json.language || '' }}",
              "type": "string"
            },
            {
              "id": "ce93468a-c748-5832-96ef-2f738c2b83fb",
              "name": "meId",
              "value": "={{ $json.meId || '' }}",
              "type": "string"
            },
            {
              "id": "d9638d9b-1c6f-5585-a881-816fa0e104b4",
              "name": "cvrId",
              "value": "={{ $json.cvrId || '' }}",
              "type": "string"
            },
            {
              "id": "c66c4bc8-9152-5a61-bdba-89e9556bd268",
              "name": "fin",
              "value": "={{ $json.fin || '' }}",
              "type": "string"
            },
            {
              "id": "aa537e05-975a-5bca-842b-492ab44dd2ee",
              "name": "plate",
              "value": "={{ $json.plate || '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "573141af-0b20-53e6-a40a-996d6603352e",
      "name": "ShapeCustomer",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        416,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "d8916f84-98a3-581e-af53-17b5d0a6fa87",
              "name": "ok",
              "value": false,
              "type": "boolean"
            },
            {
              "id": "584c3aed-7995-528e-a763-ad34020068ea",
              "name": "error",
              "value": "={{ JSON.stringify($json.error || {}).includes('409') ? 'slot_taken' : 'backend_unavailable' }}",
              "type": "string"
            },
            {
              "id": "7198d657-e277-5495-a4d8-4863d12032d4",
              "name": "message",
              "value": "={{ JSON.stringify($json.error || {}).includes('409') ? 'That slot was taken in the meantime. Call FindSlots again and offer new options.' : 'The backend system is unavailable. Apologise once and hand the caller to an agent (BACKEND_UNAVAILABLE).' }}",
              "type": "string"
            },
            {
              "id": "32190708-c1d5-52e9-a7c1-b92a567bd2b7",
              "name": "detail",
              "value": "={{ String(($json.error || {}).message || '').slice(0, 200) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "99f1f1a6-3ffa-56ab-a0a0-ad63615bf74b",
      "name": "ReturnCrmError",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        416,
        272
      ]
    },
    {
      "parameters": {
        "content": "## Identify\n\nCRM lookup by VIN and number. Returns the greeting name and the vehicle label, never the identifiers.",
        "width": 656,
        "height": 624,
        "color": 3
      },
      "id": "zone-01",
      "name": "zone-01",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -64,
        -144
      ]
    },
    {
      "parameters": {
        "content": "## AR-10 Identify customer\n\nIdentity from the UUI: VIN for an in-car call, the phone number for an IVR call. The model never sees either. Every caller then verifies with the four-digit PIN through VerifyIdentity (AR-18).",
        "width": 704,
        "height": 256,
        "color": 6
      },
      "id": "zone-panel-1",
      "name": "zone-panel-1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -64,
        -416
      ]
    }
  ],
  "connections": {
    "ToolInput": {
      "main": [
        [
          {
            "node": "CallCrm",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "CallCrm": {
      "main": [
        [
          {
            "node": "ShapeCustomer",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "ReturnCrmError",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "saveDataSuccessExecution": "all"
  },
  "meta": {
    "description": "Looks the caller up in the CASE customer account from the UUI identifiers (VIN first, then the phone number). Inputs: vin, msisdn, correlationId. Returns {ok, known, customerRef, accountName, greetingName, vehicleLabel, preferredDealerId, preferredDealerName, market, language}. Called by AR-01, never by the model."
  },
  "tags": [
    "voice-booking",
    "sub-workflow"
  ],
  "project": "Voice Booking",
  "folder": "Voice Booking Agent"
}