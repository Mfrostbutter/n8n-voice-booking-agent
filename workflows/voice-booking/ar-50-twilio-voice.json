            {
              "id": "6be4e4ce-82f3-58d6-835b-6d2067acd363",
              "name": "uuiHex",
              "value": "={{ (t => String(t || '').split('').map(ch => ch.charCodeAt(0).toString(16).padStart(2, '0')).join('').toUpperCase())(['1', ('TW-' + String($('ReceiveTwilioCall').first().json.body.CallSid || Date.now()).slice(-10)), $('PickCustomer').first().json.vin || '', $('PickCustomer').first().json.msisdn || '', $('PickCustomer').first().json.language || 'en'].join(';')) }}",
