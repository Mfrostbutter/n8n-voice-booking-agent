              "id": "32db7cde-9633-5422-b87a-b486104b16a4",
              "name": "uuiRaw",
              "value": "={{ ['1', ('TW-' + String($('ReceiveTwilioCall').first().json.body.CallSid || Date.now()).slice(-10)), $('PickCustomer').first().json.vin || '', $('PickCustomer').first().json.msisdn || '', $('PickCustomer').first().json.language || 'en'].join(';') }}",
