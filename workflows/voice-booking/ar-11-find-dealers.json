{
  "name": "AR-11 Tool: Find dealers",
  "nodes": [
    {
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "sessionId",
              "type": "string"
            },
            {
              "name": "city",
              "type": "string"
            }
          ]
        }
      },
      "id": "517c8317-6a55-5156-af32-e180a14877bd",
      "name": "ToolInput",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "PENDING"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "sessionId",
              "condition": "eq",
              "keyValue": "={{ $json.sessionId }}"
            }
          ]
        },
        "returnAll": false,
        "limit": 1
      },
      "id": "47b5b45c-5999-5c60-9e1a-16f7aee79e7e",
      "name": "LoadSession",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        208,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/ar-mock/dealerbook/dealers",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ market: $json.market, city: $('ToolInput').first().json.city || '' }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "49b2f477-52cf-5525-98f3-4a1b1a1dedc4",
      "name": "CallDealerBookDealers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        416,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b97a5886-257f-529c-afe6-eef88599b49e",
              "name": "ok",
              "value": true,
              "type": "boolean"
            },
            {
              "id": "f6a5e2f5-a285-5771-bd2b-cd8926d6168e",
              "name": "count",
              "value": "={{ ($json.dealers || []).slice(0, 5).length }}",
              "type": "number"
            },
            {
              "id": "0ee022ce-719b-5e4a-adf3-c61dc018e255",
              "name": "dealers",
              "value": "={{ ($json.dealers || []).slice(0, 5) }}",
              "type": "array"
            },
            {
              "id": "e3038678-c2ad-53e2-a959-fec5dcf9364f",
              "name": "note",
              "value": "={{ ($json.dealers || []).length ? 'Offer at most two by name. Dealers with bookable false cannot be booked here.' : 'No dealer matched. Ask for another city or offer the preferred dealer.' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "dc51ca55-855f-5882-85ca-74dc01530782",
      "name": "ShapeDealers",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        624,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "e400ab50-5c66-5315-a885-d2a8c643e2e0",
              "name": "ok",
              "value": false,
              "type": "boolean"
            },
            {
              "id": "ef580a66-8745-5d76-8afb-b6974abebac5",
              "name": "error",
              "value": "={{ JSON.stringify($json.error || {}).includes('409') ? 'slot_taken' : 'backend_unavailable' }}",
              "type": "string"
            },
            {
              "id": "bc27d364-9079-5932-a39c-9cb56e354a81",
              "name": "message",
              "value": "={{ JSON.stringify($json.error || {}).includes('409') ? 'That slot was taken in the meantime. Call FindSlots again and offer new options.' : 'The backend system is unavailable. Apologise once and hand the caller to an agent (BACKEND_UNAVAILABLE).' }}",
              "type": "string"
            },
            {
              "id": "bed13627-6ab4-5417-8a0b-b66ababf1042",
              "name": "detail",
              "value": "={{ String(($json.error || {}).message || '').slice(0, 200) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "51994285-87b5-5fe4-8e8f-d8f37cfcd5c7",
      "name": "ReturnDealersError",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        624,
        272
      ]
    },
    {
      "parameters": {
        "content": "## Find dealers\n\nDealerBook dealer search by city; bookable tells the agent whether the dealer can be booked here.",
        "width": 864,
        "height": 624,
        "color": 5
      },
      "id": "zone-01",
      "name": "zone-01",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -64,
        -144
      ]
    },
    {
      "parameters": {
        "content": "## AR-11 FindDealers\n\nMarket comes from the session row, city from the model. Non-bookable dealers are returned flagged so the agent routes them to a handoff.",
        "width": 704,
        "height": 256,
        "color": 6
      },
      "id": "zone-panel-1",
      "name": "zone-panel-1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -64,
        -416
      ]
    }
  ],
  "connections": {
    "ToolInput": {
      "main": [
        [
          {
            "node": "LoadSession",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "LoadSession": {
      "main": [
        [
          {
            "node": "CallDealerBookDealers",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "CallDealerBookDealers": {
      "main": [
        [
          {
            "node": "ShapeDealers",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "ReturnDealersError",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "saveDataSuccessExecution": "all"
  },
  "meta": {
    "description": "Agent tool. Lists dealers for the session's market, optionally filtered by city. Inputs: sessionId (plumbed), city. Returns {ok, dealers:[{dealerId, name, city, bookable}]}."
  },
  "tags": [
    "voice-booking",
    "sub-workflow"
  ],
  "project": "Voice Booking",
  "folder": "Voice Booking Agent"
}