      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ (a => ({ ok: true, count: a.length, appointments: a.map(x => ({ bookingRef: x.bookingRef, referenceCode: x.referenceCode, when: x.label, dealerName: x.dealerName })), note: a.length === 1 ? 'This is the appointment in hand. Read it back (day, time, dealer). To cancel: move to CONFIRM_CANCEL and ask for an explicit yes. To reschedule: ask for the earliest new date and call FindSlots.' : a.length ? 'Several appointments. Ask which one by day and dealer, then call FindAppointment again with its reference code as bookingRef.' : 'No booked appointment found. Offer to book a new one (intent BOOK) or hand off with SCENARIO_REQUIRES_AGENT.' }))($('ShapeAppointments').first().json.appointments) }}",
